# Environment Variables Template
# Copy this file to .env and update the values for your local environment.

# Database
# Connection URI for the primary PostgreSQL instance.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname # pragma: allowlist secret

# Security
# Internal service authentication key.
API_KEY=YOUR_SECURE_API_KEY_HERE

# Node Runtime
# Environment (development, production, testing)
NODE_ENV=development

# Infrastructure
# Port for the web frontend/API server
PORT=3000
