{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hy/projects/video-analysis/.codex/hooks/git-policy-enforce.sh'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hy/projects/video-analysis/.codex/hooks/pre-tool-validate.sh'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: Knowledge graph exists. If it is current and relevant, use graphify-out/GRAPH_REPORT.md as supporting context; canonical source files, Stage 00 governance, templates, and validators remain authoritative.\"}}'   || true ;; esac",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hy/projects/video-analysis/.codex/hooks/docs-readme-sync.sh'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hy/projects/video-analysis/.codex/hooks/post-tool-format.sh'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hy/projects/video-analysis/.codex/hooks/post-tool-validate.sh'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hy/projects/video-analysis/.codex/hooks/pre-compact-context.sh'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/hy/projects/video-analysis/.codex/hooks/session-start.sh'",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/validation/validate-doc-governance.sh && python3 scripts/validation/validate-doc-readiness.py'",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash '/home/hy/projects/video-analysis/.codex/hooks/stop-completion-governance.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
